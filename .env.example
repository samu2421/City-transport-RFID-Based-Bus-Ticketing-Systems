# Copy this file to .env and fill in your own values. Never commit .env.

# Secret used to sign login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=change-me

# Razorpay API keys (Dashboard > Account & Settings > API Keys). Use test-mode keys (rzp_test_...).
# Without them the app still runs, but the Pay button reports that online payment is not configured.
RAZOR_KEY=
RAZOR_SECRET=

# Optional: database connection URL. Leave unset to use SQLite at instance/travel.db.
# DATABASE_URL=sqlite:////absolute/path/to/travel.db

# Optional: address and port used by `python -m smart_travel.main` (defaults shown).
# FLASK_RUN_HOST=0.0.0.0
# FLASK_RUN_PORT=5000
# FLASK_DEBUG=0
